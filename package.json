{
  "name": "stellar-sdk-complete-test",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:node": "node --test tests/*.test.ts",
    "test:deno": "deno test --no-check --allow-net --allow-read --allow-env tests/",
    "test:bun": "bun test tests/*.test.ts",
    "test:all": "bash scripts/test-runtimes.sh",
    "test:browser": "node --test browser-tests/*.test.mjs",
    "test:pm": "bash scripts/test-pms.sh",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "playwright": "^1.62.1",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "16.2.0"
  }
}
